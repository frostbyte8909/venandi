# Copy this file to .env and fill in your values before running Venandi.
# NEVER commit the actual .env file to version control.

# SQLite database path
DATABASE_URL=sqlite://venandi.db

# 256-bit+ random secret for HMAC dynamic flag generation
# Generate: openssl rand -hex 32
VENANDI_SERVER_SECRET=change_me_to_a_256bit_random_hex_string

# 256-bit+ random secret for JWT signing
# Generate: openssl rand -hex 32
VENANDI_JWT_SECRET=change_me_to_another_256bit_random_hex_string

# Discord bot token from https://discord.com/developers/applications
VENANDI_DISCORD_TOKEN=your_discord_bot_token_here

# Discord channel ID where telemetry events are posted
VENANDI_DISCORD_CHANNEL_ID=0

# Comma-separated list of allowed WebSocket origins (no trailing slashes)
VENANDI_ALLOWED_ORIGINS=https://ctf.example.com,http://localhost:3000

# Bootstrap admin account (checked once at boot, safe to remove afterward)
VENANDI_INITIAL_ADMIN_EMAIL=admin@example.com
VENANDI_INITIAL_ADMIN_PASSWORD=change_me_strong_password

# Axum bind address (optional, defaults to 0.0.0.0:3000)
VENANDI_BIND_ADDR=0.0.0.0:3000

# Logging level (optional, defaults to info)
RUST_LOG=venandi=info
